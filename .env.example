# Copy this file to `.env` before running the project.
# Docker Compose will read these values, and the backend can also load `.env`
# directly when started outside Docker.

OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
DATABASE_URL=postgresql+psycopg://sar_demo:sar_demo@postgres:5432/sar_demo
UPLOAD_DIR=/app/data/uploads
TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_INTERVAL_SECONDS=3
